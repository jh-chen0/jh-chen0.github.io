            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Needle Tip Tracking in 2D Ultrasound based on Improved Compressive Tracking and Adaptive Kalman Filter</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:format>application/postscript</dc:format>
